# ~/deploy/store-metrics/.env on the server (chmod 600). Never commit the real file.
# systemd EnvironmentFile does not expand ${...}: write DATABASE_URL with the literal password.
DB_BIND=127.0.0.1
POSTGRES_PASSWORD=
DATABASE_URL=postgres://store_metrics:<password>@127.0.0.1:5441/store_metrics?sslmode=disable
APPS_CONFIG=/home/<user>/deploy/store-metrics/apps.yaml
RAW_DIR=/home/<user>/store-metrics-data/raw
EXPORT_CSV=/home/<user>/store-metrics-data/export/metrics_daily.csv
# App Store Connect: API key with role Finance (Users and Access > Integrations)
ASC_KEY_ID=<key id>
ASC_ISSUER_ID=<issuer uuid>
ASC_KEY_PATH=/home/<user>/deploy/store-metrics/secrets/AuthKey_<key id>.p8
ASC_VENDOR=<vendor number from Payments and Financial Reports>
# Google Play: service account with "View app information and download bulk reports" + "View financial data"
GOOGLE_SA_JSON=/home/<user>/deploy/store-metrics/secrets/play-service-account.json
GCS_BUCKET=pubsite_prod_<developer account id>
# Postgres data directory and the address port 5441 listens on (docker-compose.yml uses both).
DB_DIR=/home/<user>/<data dir>/db
# Usage telemetry receiver (README „Měření“). Off until COMPOSE_PROFILES=telemetry.
# POSTGRES_PASSWORD goes into the ingest DATABASE_URL as is: use only URL-safe characters.
COMPOSE_PROFILES=
TELEMETRY_TUNNEL_TOKEN=<cloudflared tunnel token>
TELEMETRY_RATE_PER_MIN=60
TELEMETRY_DAILY_CAP=200000
